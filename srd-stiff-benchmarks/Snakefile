"""Snakemake workflow — tüm benchmark pipeline'ı."""
import yaml
from pathlib import Path

configfile: "configs/experiment.yaml"

PROBLEMS = config["problems"]
SOLVERS = config["solvers"]
SEEDS = list(range(config["n_seeds"]))
RESULTS_DIR = Path(config["output_dir"])


rule all:
    input:
        RESULTS_DIR / "aggregated.parquet",
        RESULTS_DIR / "performance_profiles.png",
        RESULTS_DIR / "statistical_tests.csv",
        RESULTS_DIR / "report.html",


rule run_experiment:
    output:
        RESULTS_DIR / "raw/{solver}__{problem}__seed{seed}.json"
    params:
        max_iter=config["max_iter"],
        max_time=config["max_time_sec"],
    threads: 1
    resources:
        mem_mb=8000,
        time_min=60,
    shell:
        """
        set OMP_NUM_THREADS=1 && set MKL_NUM_THREADS=1 && python scripts/run_single.py --problem {wildcards.problem} --solver {wildcards.solver} --seed {wildcards.seed} --output-dir {RESULTS_DIR}/raw --max-iter {params.max_iter} --max-time {params.max_time}
        """


rule aggregate:
    input:
        expand(
            RESULTS_DIR / "raw/{solver}__{problem}__seed{seed}.json",
            solver=SOLVERS, problem=PROBLEMS, seed=SEEDS,
        )
    output:
        RESULTS_DIR / "aggregated.parquet"
    shell:
        "python scripts/aggregate.py --input-dir {RESULTS_DIR}/raw --output {output}"


rule generate_profiles:
    input:
        RESULTS_DIR / "aggregated.parquet"
    output:
        RESULTS_DIR / "performance_profiles.png"
    shell:
        "python scripts/plot_profiles.py --input {input} --output {output}"


rule statistical_tests:
    input:
        RESULTS_DIR / "aggregated.parquet"
    output:
        RESULTS_DIR / "statistical_tests.csv"
    shell:
        "python scripts/run_stats.py --input {input} --output {output}"


rule generate_report:
    input:
        agg=RESULTS_DIR / "aggregated.parquet",
        profiles=RESULTS_DIR / "performance_profiles.png",
        stats=RESULTS_DIR / "statistical_tests.csv",
    output:
        RESULTS_DIR / "report.html"
    shell:
        "python scripts/generate_report.py "
        "--agg {input.agg} --profiles {input.profiles} "
        "--stats {input.stats} --output {output}"
